# Local bidding-service configuration.
# Copy to .env and replace change-me values before running outside Docker.

PORT=3001
MONGO_URI=mongodb://backhaulbid:change-me-mongodb-password@localhost:27017/backhaulbid_bidding?authSource=admin
REDIS_URL=redis://:change-me-redis-password@localhost:6379
RABBITMQ_URL=amqp://backhaulbid:change-me-rabbitmq-password@localhost:5672
WALLET_SERVICE_URL=http://localhost:8083
INTERNAL_WALLET_TOKEN=change-me-internal-wallet-token

SWAGGER_ENABLED=true
OPENAPI_GATEWAY_SERVER_URL=/api/v1/bidding
OPENAPI_DIRECT_SERVER_URL=http://localhost:3001
